# Copy to .env (git-ignored). Never commit real values.
# RPC for the chain you deploy to: Ethereum mainnet (1) or Base (8453)
RPC_URL=
# Preferred signer: Foundry keystore account name (forge --account). Used by make deploy-*.
DEPLOYER_ACCOUNT=
# Alternative signer: path to a keystore JSON file (forge --keystore)
DEPLOYER_KEYSTORE=
# Alternative signer: raw private key. Only needed for a live --broadcast. Leave empty for dry runs.
DEPLOYER_KEY=
# Must be exactly "yes" to allow a live broadcast on chain 1 / 8453
CONFIRM_MAINNET=
# Etherscan v2 API key (one key covers Ethereum and Base)
ETHERSCAN_API_KEY=
# Optional named endpoints used by foundry.toml [rpc_endpoints] and fork tests
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
# Optional path the deploy script writes factory/USDC addresses to
DEPLOYMENTS_PATH=web/src/deployments.json
